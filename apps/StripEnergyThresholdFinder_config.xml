<?xml version="1.0" encoding="UTF-8"?>
<StripEnergyThresholdFinder>
  <Input>
    <DataFiles>
      <DataFile>/path/to/your/data/file0.hdf5</DataFile>
      <DataFile>/path/to/your/data/file1.hdf5</DataFile>
    </DataFiles>
    <CalibrationFile>/path/to/calibration/file.ecal</CalibrationFile>
    <StripMap>/path/to/stripmap.map</StripMap>
  </Input>

  <Output>
    <Prefix>your_output_file_prefix</Prefix>
    <SaveDiagnosticPlots>false</SaveDiagnosticPlots>
  </Output>

  <Analysis>
    <!-- Detector selection -->
    <!-- If ProcessAllDetectors is false, only DetectorID is analyzed. -->
    <!-- If ProcessAllDetectors is true, DetectorID is ignored. -->
    <DetectorID>0</DetectorID>
    <ProcessAllDetectors>false</ProcessAllDetectors>

    <!-- Threshold analysis parameters -->
    <MinEntries>5</MinEntries>
    <FallbackThresholdKeV>18</FallbackThresholdKeV>
    <NoiseSearchMaxKeV>40</NoiseSearchMaxKeV>
    <NoiseStartMinCounts>50</NoiseStartMinCounts>
    <FastFallbackKeV>34</FastFallbackKeV>
    <FastSearchRangeADC>800</FastSearchRangeADC>
  </Analysis>
</StripEnergyThresholdFinder>